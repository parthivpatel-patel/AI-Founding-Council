# Copy to .env and fill only the providers you have verified.
# Leave unused keys empty. Never commit .env.
# Free quotas and pricing change. Do not assume a key is permanently free.
# Paid usage requires explicit CEO authorization.

# ChatGPT / OpenAI. Default strategist provider.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API_AUTHORIZED=

# Claude / Anthropic. Default red team provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_AUTHORIZED=

# Gemini. Default researcher provider.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_AUTHORIZED=

# Grok / xAI. Default contrarian provider.
XAI_API_KEY=
XAI_MODEL=
XAI_API_AUTHORIZED=

# NVIDIA NIM. Assign it with a role override below.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_API_AUTHORIZED=

# Cursor is the CTO. A local Cursor agent can use tools, so it stays unauthorized until you set the flag.
CURSOR_API_KEY=
CURSOR_MODEL=
CURSOR_API_AUTHORIZED=

# Optional role overrides: openai, anthropic, gemini, xai, nvidia, cursor
STRATEGIST_PROVIDER=openai
RESEARCHER_PROVIDER=gemini
RED_TEAM_PROVIDER=anthropic
CONTRARIAN_PROVIDER=xai
CTO_PROVIDER=cursor
